PORT=4000

# Alertes push "nouvelle mission" (Web Push / VAPID). Générer une paire avec :
#   npx web-push generate-vapid-keys
# Sans ces clés, les alertes sont simplement désactivées (aucun impact sur le reste de l'app).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contact@hair-renfort.app"
